{
  "root": "scene",
  "elements": {
    "scene": {
      "type": "Group",
      "props": { "position": [0, 0, 0] },
      "children": ["ambient", "violetRim", "box"]
    },
    "ambient": {
      "type": "AmbientLight",
      "props": { "intensity": 0.45 },
      "children": []
    },
    "violetRim": {
      "type": "PointLight",
      "props": {
        "position": [0, 1, 2],
        "color": "#b98fd1",
        "intensity": 6,
        "distance": 6,
        "decay": 2
      },
      "children": []
    },
    "box": {
      "type": "RibbonBox",
      "props": {
        "boxColor": "#241531",
        "ribbonColor": "#e0c285",
        "open": { "$bindState": "/boxOpen" }
      },
      "children": [],
      "on": {
        "click": {
          "action": "setState",
          "params": { "statePath": "/boxOpen", "value": true }
        }
      }
    }
  }
}
