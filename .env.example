# Copy to .env.local for local dev. Never commit the real values.
# In production, set these in the Vercel project's Environment Variables —
# not in a committed file.

# The passcode she'll actually type on the /gate page.
GATE_PASSCODE=

# A long random secret used as the access-cookie value — NOT the same as
# GATE_PASSCODE. Generate one with: openssl rand -hex 32
GATE_TOKEN=
